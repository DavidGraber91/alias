{
  "rules": {
    ".read": false,
    ".write": false,
    "stats": {
      ".read": "auth != null && auth.token.email == 'davidgraber91@gmail.com' && auth.token.email_verified == true",
      "created": { ".write": "newData.isNumber()" }
    },
    "rooms": {
      ".read": "auth != null && auth.token.email == 'davidgraber91@gmail.com' && auth.token.email_verified == true",
      "$code": {
        ".read": true,
        ".write": "newData.exists() || (auth != null && auth.token.email == 'davidgraber91@gmail.com' && auth.token.email_verified == true)",
        ".validate": "newData.hasChildren(['s', 't'])",
        "s": { ".validate": "newData.isString()" },
        "t": { ".validate": "newData.isNumber()" },
        "u": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
